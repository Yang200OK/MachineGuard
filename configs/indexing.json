{
  "schema": "machineguard.indexing.v1",
  "embedding_model": "qwen3.7-text-embedding",
  "dimension": 1024,
  "embedding_endpoint": "https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding",
  "key_env": "DASHSCOPE_API_KEY",
  "batch_size": 10,
  "request_seconds": 60,
  "timeout_seconds": 600,
  "max_chunks": 1500,
  "tokenizer_version": "latin-identifiers-han-bigrams-v1",
  "bm25_k1": 1.5,
  "bm25_b": 0.75,
  "rrf_k": 60
}
